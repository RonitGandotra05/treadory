{
  "name": "treadory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:extension && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/check-release.mjs && node verification/seo.mjs && node --test verification/native-bridge.test.mjs verification/helper-artifact.test.mjs verification/app-artifact.test.mjs && node verification/native-worker.mjs",
    "build:web": "node scripts/package-app.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:helper-package": "node scripts/package-helper.mjs",
    "build:helper-snapshot": "node scripts/stage-helper.mjs",
    "test:native": "dotnet run --project native/windows -- --self-test",
    "build:app-snapshot": "node scripts/stage-app.mjs",
    "test:app": "dotnet run --project native/windows-app-tests",
    "test:bridge": "node --test verification/native-bridge.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "esbuild": "0.24.2"
  }
}
