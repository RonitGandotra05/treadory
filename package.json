{
  "name": "treadory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:extension && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/check-release.mjs",
    "build:web": "tsc -b && vite build && node scripts/prerender.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "esbuild": "0.24.2"
  }
}
