<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Treadory</AssemblyName><Version>0.3.0</Version><DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../windows/Engine.cs" Link="Engine.cs" />
    <Compile Include="../windows/WindowsBackend.cs" Link="WindowsBackend.cs" />
    <EmbeddedResource Include="README.md" />
    <EmbeddedResource Include="../windows/DOTNET-APPHOST-LICENSE.txt" Link="DOTNET-APPHOST-LICENSE.txt" />
    <EmbeddedResource Include="../windows/DOTNET-THIRD-PARTY-NOTICES.txt" Link="DOTNET-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
